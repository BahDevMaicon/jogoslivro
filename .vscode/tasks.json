{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^ERROR$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "> vite",
          "endsPattern": "ready in \\d+ ms"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "group": { "kind": "build", "isDefault": true },
      "detail": "Inicia o servidor de desenvolvimento (Vite) em http://localhost:5173"
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "problemMatcher": ["$tsc"],
      "group": "build",
      "detail": "Gera o build de produção"
    },
    {
      "label": "preview",
      "type": "npm",
      "script": "preview",
      "isBackground": true,
      "problemMatcher": [],
      "detail": "Serve o build de produção localmente"
    },
    {
      "label": "test",
      "type": "npm",
      "script": "test",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "detail": "Roda a suíte de testes (Vitest)"
    },
    {
      "label": "lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"],
      "detail": "Roda o ESLint"
    },
    {
      "label": "typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"],
      "detail": "Checa os tipos TypeScript"
    }
  ]
}
